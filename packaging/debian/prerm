#!/bin/sh
set -e

case "$1" in
  remove|upgrade|deconfigure)
    if command -v systemctl > /dev/null 2>&1 && systemctl is-system-running --quiet 2>/dev/null; then
      systemctl stop webfilter-proxy.service webfilter-mgmt.service 2>/dev/null || true
      if [ "$1" = "remove" ]; then
        systemctl disable webfilter-proxy.service webfilter-mgmt.service 2>/dev/null || true
      fi
    fi
    ;;

  failed-upgrade)
    ;;

  *)
    echo "prerm called with unknown argument '$1'" >&2
    exit 1
    ;;
esac

exit 0
