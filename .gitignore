# Local Claude Code workspace (settings, plans, memory) — never committed
.claude/

# Python runtime / deps (bundled only in release archives)
.venv/
runtime/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Build output
dist/
*.tar.gz
*.zip

# Release version stamp — written by CI into the archive, never committed
/VERSION

# Generated at runtime — never commit
certs/
logs/
models/*.joblib

# Downloaded site-category blocklists (populated by scripts/update_categories.sh)
/categories/*
!/categories/.gitkeep

# Local config holds secrets (password hash, cookie secret) — ship the example instead
config/settings.json

# Personal policies — only the default ships
policies/*.json
!policies/default.json
